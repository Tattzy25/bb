<div 
  class="orb-container" 
  style="background-color: {{ block.settings.bg_color }}; width: 100%; height: 100vh; position: relative; overflow: hidden;"
>
  <canvas-orb 
    data-wireframe="{{ block.settings.wireframe }}" 
    data-scale="{{ block.settings.scale }}"
    data-color-base="{{ block.settings.color_base }}"
    style="position: absolute; inset: 0; width: 100%; height: 100%;"
  ></canvas-orb>
</div>

<script type="module">
  import * as THREE from 'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.module.js';

  class CanvasOrb extends HTMLElement {
    constructor() {
      super();
      this.frameId = null;
    }

    connectedCallback() {
      // 1. Read Settings
      const isWireframe = this.getAttribute('data-wireframe') === 'true';
      const scale = parseFloat(this.getAttribute('data-scale')) || 0.8;
      const colorBase = this.getAttribute('data-color-base') || '#0d0d0d';

      // 2. Setup Scene
      const scene = new THREE.Scene();
      const width = this.clientWidth || window.innerWidth;
      const height = this.clientHeight || window.innerHeight;
      const camera = new THREE.PerspectiveCamera(75, width / height, 0.1, 1000);
      camera.position.z = 3.45;
      camera.position.y = -0.5;

      const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setSize(width, height);
      renderer.setPixelRatio(window.devicePixelRatio);
      this.appendChild(renderer.domElement);

      // 3. Shaders
      const vertexShader = `
        varying vec2 vUv;
        varying vec3 vNormal;
        varying vec3 vViewPosition;
        varying float vDisplacement;
        uniform float uTime;
        
        vec3 mod289(vec3 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
        vec4 mod289(vec4 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
        vec4 permute(vec4 x) { return mod289(((x*34.0)+1.0)*x); }
        vec4 taylorInvSqrt(vec4 r) { return 1.79284291400159 - 0.85373472095314 * r; }

        float snoise(vec3 v) {
          const vec2  C = vec2(1.0/6.0, 1.0/3.0);
          const vec4  D = vec4(0.0, 0.5, 1.0, 2.0);
          vec3 i  = floor(v + dot(v, C.yyy) );
          vec3 x0 =   v - i + dot(i, C.xxx) ;
          vec3 g = step(x0.yzx, x0.xyz);
          vec3 l = 1.0 - g;
          vec3 i1 = min( g.xyz, l.zxy );
          vec3 i2 = max( g.xyz, l.zxy );
          vec3 x1 = x0 - i1 + C.xxx;
          vec3 x2 = x0 - i2 + C.yyy*2.0;
          vec3 x3 = x0 - D.yyy;
          i = mod289(i);
          vec4 p = permute( permute( permute( i.z + vec4(0.0, i1.z, i2.z, 1.0 )) + i.y + vec4(0.0, i1.y, i2.y, 1.0 )) + i.x + vec4(0.0, i1.x, i2.x, 1.0 ));
          float n_ = 0.142857142857;
          vec3  ns = n_ * D.wyz - D.xzx;
          vec4 j = p - 49.0 * floor(p * ns.z * ns.z);
          vec4 x_ = floor(j * ns.z);
          vec4 y_ = floor(j - 7.0 * x_ );
          vec4 x = x_ *ns.x + ns.yyyy;
          vec4 y = y_ *ns.x + ns.yyyy;
          vec4 h = 1.0 - abs(x) - abs(y);
          vec4 b0 = vec4( x.xy, y.xy );
          vec4 b1 = vec4( x.zw, y.zw );
          vec4 s0 = floor(b0)*2.0 + 1.0;
          vec4 s1 = floor(b1)*2.0 + 1.0;
          vec4 sh = -step(h, vec4(0.0));
          vec4 a0 = b0.xzyw + s0.xzyw*sh.xxyy ;
          vec4 a1 = b1.xzyw + s1.xzyw*sh.zzww ;
          vec3 p0 = vec3(a0.xy,h.x);
          vec3 p1 = vec3(a0.zw,h.y);
          vec3 p2 = vec3(a1.xy,h.z);
          vec3 p3 = vec3(a1.zw,h.w);
          vec4 norm = taylorInvSqrt(vec4(dot(p0,p0), dot(p1,p1), dot(p2, p2), dot(p3,p3)));
          p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w;
          vec4 m = max(0.6 - vec4(dot(x0,x0), dot(x1,x1), dot(x2,x2), dot(x3,x3)), 0.0);
          m = m * m;
          return 42.0 * dot( m*m, vec4( dot(p0,x0), dot(p1,x1), dot(p2,x2), dot(p3,x3) ) );
        }

        void main() {
          vUv = uv;
          vNormal = normalize(normalMatrix * normal);
          float noise = snoise(position * 1.5 + uTime * 0.4);
          vDisplacement = noise * 0.15;
          vec3 newPosition = position + normal * vDisplacement;
          vec4 mvPosition = modelViewMatrix * vec4(newPosition, 1.0);
          vViewPosition = -mvPosition.xyz;
          gl_Position = projectionMatrix * mvPosition;
        }
      `;

      const fragmentShader = `
        varying vec2 vUv;
        varying vec3 vNormal;
        varying vec3 vViewPosition;
        varying float vDisplacement;
        uniform vec3 uBaseColor;

        void main() {
          vec3 normal = normalize(vNormal);
          vec3 viewDir = normalize(vViewPosition);
          float fresnel = pow(clamp(1.0 - dot(normal, viewDir), 0.0001, 1.0), 3.0);
          float spec = pow(clamp(dot(reflect(-viewDir, normal), vec3(0.0, 1.0, 0.0)), 0.0001, 1.0), 32.0);
          
          vec3 finalColor = mix(uBaseColor, vec3(0.9, 0.9, 1.0), fresnel + spec);
          finalColor += vec3(0.1, 0.1, 0.2) * vDisplacement;
          
          gl_FragColor = vec4(finalColor, 1.0);
        }
      `;

      const geometry = new THREE.IcosahedronGeometry(1, 64);
      const material = new THREE.ShaderMaterial({
        vertexShader,
        fragmentShader,
        uniforms: {
          uTime: { value: 0 },
          uBaseColor: { value: new THREE.Color(colorBase) }
        },
        wireframe: isWireframe,
        transparent: true,
      });

      const sphere = new THREE.Mesh(geometry, material);
      sphere.scale.setScalar(scale);
      scene.add(sphere);

      // 4. Animation Loop
      const animate = (time) => {
        material.uniforms.uTime.value = time * 0.001;
        sphere.rotation.y += 0.005;
        sphere.rotation.z += 0.002;
        renderer.render(scene, camera);
        this.frameId = requestAnimationFrame(animate);
      };
      
      this.frameId = requestAnimationFrame(animate);

      // 5. Resize Handler
      window.addEventListener('resize', () => {
        const w = this.clientWidth;
        const h = this.clientHeight;
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h);
      });
    }

    disconnectedCallback() {
      if (this.frameId) cancelAnimationFrame(this.frameId);
    }
  }

  if (!customElements.get('canvas-orb')) {
    customElements.define('canvas-orb', CanvasOrb);
  }
</script>

{% schema %}
{
  "name": "Orb 3D Viewer",
  "target": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "wireframe",
      "label": "Enable Wireframe",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "color_base",
      "label": "Base Color",
      "default": "#0d0d0d"
    },
    {
      "type": "range",
      "id": "scale",
      "min": 0.1,
      "max": 2.0,
      "step": 0.1,
      "label": "Scale",
      "default": 0.8
    }
  ]
}
{% endschema %}